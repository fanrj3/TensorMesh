# TensorMesh configuration — copy to /etc/tensormesh/tensormesh.env
# install.sh generates this file with values detected on your host;
# <...> placeholders below are for manual installs.

# API listen address and port.
TENSORMESH_HOST=0.0.0.0
TENSORMESH_PORT=4317

# Web UI port and the URL users open in the browser (used for token links).
TENSORMESH_WEB_PORT=8000
TENSORMESH_WEB_URL=http://<server-ip>:8000

# SQLite database location.
TENSORMESH_DB_PATH=<install-dir>/data/tensormesh.db

# Telemetry collection interval (ms) and Slurm job history retention (days).
TENSORMESH_COLLECT_INTERVAL_MS=10000
#TENSORMESH_JOB_HISTORY_RETENTION_DAYS=240

# Default Slurm resources requested per GPU by `tmesh run`.
TENSORMESH_DEFAULT_CPUS_PER_GPU=4
TENSORMESH_DEFAULT_MEM_PER_GPU=24G

# Optional: mail notifications via a CloudMail-compatible HTTPS JSON API.
# Mail reminders stay disabled unless endpoint and token are both configured.
#TENSORMESH_CLOUDMAIL_ENDPOINT=https://mail.example.com/external/api/send_mail
#TENSORMESH_CLOUDMAIL_TOKEN_FILE=/etc/tensormesh/cloudmail.jwt
#TENSORMESH_MAIL_FROM_NAME=TensorMesh

# Optional: extra web reverse-proxy routes, "/prefix=http://127.0.0.1:port".
#TENSORMESH_WEB_PROXY_REGISTRY=/my_service=http://127.0.0.1:9001
